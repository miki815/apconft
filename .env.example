# --- NFT mint (after ApcoPay callback) — all three required ---
# RPC: Sepolia HTTPS from Alchemy, Infura, or https://chainlist.org
RPC_URL=
# Same wallet that deployed ApconftCollection (onlyOwner); 0x + 64 hex chars
FULFILLER_PRIVATE_KEY=
# From deploy: cd contracts && npm install && npm run deploy:sepolia
NFT_CONTRACT_ADDRESS=
# ApconftBattleEscrow address from the same deploy script
BATTLE_ESCROW_ADDRESS=
# Optional: defaults to FULFILLER_PRIVATE_KEY if operator is the deployer wallet
# BATTLE_OPERATOR_PRIVATE_KEY=
# Required for POST /apcopay/battles/:id/resolve (header X-Battle-Resolve-Secret)
BATTLE_RESOLVE_SECRET=
# Optional: if operator is not deployer, set their address when deploying
# BATTLE_OPERATOR_ADDRESS=
# Etherscan API key (one key for V2 — Sepolia + mainnet). Verifies contracts for Read/Write on explorer.
# https://etherscan.io/apidashboard
# ETHERSCAN_API_KEY=
# Verify (escrow needs collection + operator — script reads .env): cd contracts && npm run verify:sepolia
# Optional: if RPC_URL is only for the app, you can set SEPOLIA_RPC_URL for Hardhat deploy
# SEPOLIA_RPC_URL=

# --- Full ApcoPay E2E (browser checkout) ---
# Expose local server: ngrok http 3080  → put HTTPS URL + path into CALLBACK_URL
# REDIRECT_URL can be http://localhost:3080/return or any reachable return page.

# --- Simulate only the payment callback (no ApcoPay API / no checkout UI) ---
# ALLOW_TEST_SEED=true npm start
# NFT_RECIPIENT=0x... npm run simulate:callback
# Optional: SIM_USER_ID, SIM_AMOUNT, SIM_CURRENCY_ID, TOKEN_URI, SIMULATE_BASE_URL
ALLOW_TEST_SEED=false

