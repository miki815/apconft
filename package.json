{
  "name": "apconft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "simulate:callback": "node scripts/simulate-apcopay-callback.mjs",
    "contracts:compile": "npm run compile --prefix contracts",
    "contracts:test": "npm run test --prefix contracts",
    "solana:build": "cd solana && anchor build",
    "solana:test": "cd solana && anchor test",
    "solana:web": "npm run dev --prefix solana/web",
    "solana:copy-idl-web": "npm run copy-idl --prefix solana/web",
    "poker:test": "npm test --prefix poker",
    "poker:server": "npm run server --prefix poker",
    "vault:mint-setup": "npm run vault --prefix solana -- mint-setup",
    "vault:mint": "npm run vault --prefix solana -- mint"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  }
}
